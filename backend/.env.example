# backend/.env.example
# Copy to backend/.env and fill in real values before running `npm run dev`.

PORT=5000

# CORS allow-list. Comma-separated origins, or '*' to allow any.
FRONTEND_URL=http://localhost:3000
# Used to build links in emails (verification / reset / admin-approval).
APP_URL=http://localhost:3000

# ── PostgreSQL ──────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=cviator

# ── JWT ─────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# ── Root administrator ──────────────────────────────────────────────
# The email that becomes the institution's root admin on first signup.
# Leave blank in local dev if you don't need to test admin flows.
ROOT_ADMIN_EMAIL=

# ── SMTP (leave blank to skip email sending — links are logged to console) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@cviator.local
